{
  "name": "smart-school-fintech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @smart-school/db migrate",
    "db:generate": "pnpm --filter @smart-school/db generate",
    "db:seed": "pnpm --filter @smart-school/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
