# Smart School FinTech Platform — Environment Configuration Template
# Copy this file to .env and populate with your environment secrets.
# If DATABASE_URL is not set, the application automatically enters Demo Mode
# serving realistic hardcoded demo datasets across all pages.

# Supabase Storage & Public Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL Database Connections (Prisma)
# Leave DATABASE_URL empty to run in Demo Mode for evaluations/hackathon previews.
DATABASE_URL="postgresql://postgres:your_password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15&pool_timeout=15&connection_limit=1"
DIRECT_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres?connect_timeout=15"

# Razorpay Sandbox Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret

# Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-1.5-flash"

# Resend Email Service Credentials
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Finora <onboarding@resend.dev>"

# Web Push VAPID Credentials
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Application Context & Auth
NEXT_PUBLIC_DEMO_SCHOOL_ID=demo-school-id
AUTH_SECRET=your_nextauth_secret_here
