NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Razorpay sandbox (Session 2) — obtain from https://dashboard.razorpay.com
# Sandbox mode only — never use live keys here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret

# Google Gemini API (Session 4 - Copilot & OCR)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-1.5-flash"

# Resend (Session 6 — email reminders via markReminderSent)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# VAPID Keys for Web Push Notifications (Session 3)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Demo School ID for testing AI features
NEXT_PUBLIC_DEMO_SCHOOL_ID=demo-school
